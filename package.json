{
  "name": "vadd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @vadd/server --filter @vadd/web dev",
    "lint": "biome check .",
    "schema:export": "pnpm --filter @vadd/core exec tsx scripts/export-schema.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "transcript:export": "pnpm --filter @vadd/server exec tsx scripts/export-transcript.ts",
    "eval": "pnpm --filter @vadd/server exec tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "1.4.0",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@zed-industries/agent-client-protocol": "0.4.5",
    "@zed-industries/claude-code-acp": "0.16.2",
    "execa": "^10.0.1",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

{
  "$ref": "#/definitions/AgentEvent",
  "definitions": {
    "AgentEvent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "status"
            },
            "phase": {
              "type": "string",
              "enum": [
                "exploring",
                "clarifying",
                "proposing",
                "planning",
                "executing",
                "verifying",
                "reviewing",
                "integrating"
              ]
            },
            "headline": {
              "type": "string",
              "maxLength": 120
            }
          },
          "required": ["type", "phase", "headline"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "decision_needed"
            },
            "question": {
              "type": "string",
              "maxLength": 200
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "pros": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "maxItems": 5
                  },
                  "cons": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "maxItems": 5
                  },
                  "effort": {
                    "type": "string",
                    "enum": ["S", "M", "L"]
                  },
                  "reversibility": {
                    "type": "string",
                    "enum": ["high", "medium", "low"]
                  },
                  "verification": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": ["id", "label", "pros", "cons", "reversibility", "verification"],
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 4
            },
            "recommendedId": {
              "type": "string"
            }
          },
          "required": ["type", "question", "options", "recommendedId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "clarification"
            },
            "question": {
              "type": "string",
              "maxLength": 200
            },
            "suggestedAnswers": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 80
              },
              "maxItems": 4
            }
          },
          "required": ["type", "question", "suggestedAnswers"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plan"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "expectFailing": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "maxItems": 5
                  }
                },
                "required": ["title", "description"],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 12
            }
          },
          "required": ["type", "tasks"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "task_result"
            },
            "taskId": {
              "type": "string"
            },
            "claim": {
              "type": "string",
              "maxLength": 150
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["type", "taskId", "claim", "evidenceRefs"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "evidence"
            },
            "kind": {
              "type": "string",
              "enum": ["test", "diff", "lint", "build", "check", "artifact", "warning", "security"]
            },
            "status": {
              "type": "string",
              "enum": ["pass", "fail", "warn", "info"]
            },
            "headline": {
              "type": "string",
              "maxLength": 120
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100
              },
              "maxItems": 6
            },
            "artifactPath": {
              "type": "string"
            },
            "checkId": {
              "type": "string",
              "maxLength": 40
            }
          },
          "required": ["type", "kind", "status", "headline", "summary"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "failure"
            },
            "headline": {
              "type": "string",
              "maxLength": 120
            },
            "probableCause": {
              "type": "string",
              "maxLength": 200
            },
            "suggestedActions": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100
              },
              "maxItems": 3
            }
          },
          "required": ["type", "headline", "probableCause", "suggestedActions"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "memory_note"
            },
            "kind": {
              "type": "string",
              "enum": ["architecture", "known_issue"]
            },
            "headline": {
              "type": "string",
              "maxLength": 120
            },
            "content": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": ["type", "kind", "headline", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "cards": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "role": {
                        "type": "string",
                        "enum": ["architecture", "comparison", "interface", "note"]
                      },
                      "kind": {
                        "type": "string",
                        "const": "text"
                      },
                      "body": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 600
                      }
                    },
                    "required": ["id", "title", "kind", "body"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "role": {
                        "type": "string",
                        "enum": ["architecture", "comparison", "interface", "note"]
                      },
                      "kind": {
                        "type": "string",
                        "const": "table"
                      },
                      "columns": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 40
                        },
                        "minItems": 2,
                        "maxItems": 4
                      },
                      "rows": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 80
                          }
                        },
                        "minItems": 1,
                        "maxItems": 6
                      }
                    },
                    "required": ["id", "title", "kind", "columns", "rows"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "role": {
                        "type": "string",
                        "enum": ["architecture", "comparison", "interface", "note"]
                      },
                      "kind": {
                        "type": "string",
                        "const": "code"
                      },
                      "language": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1500
                      },
                      "caption": {
                        "type": "string",
                        "maxLength": 120
                      }
                    },
                    "required": ["id", "title", "kind", "language", "code"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "role": {
                        "type": "string",
                        "enum": ["architecture", "comparison", "interface", "note"]
                      },
                      "kind": {
                        "type": "string",
                        "const": "diagram"
                      },
                      "notation": {
                        "type": "string",
                        "const": "mermaid"
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1500
                      },
                      "caption": {
                        "type": "string",
                        "maxLength": 120
                      }
                    },
                    "required": ["id", "title", "kind", "notation", "source"],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 6
            }
          },
          "required": ["type", "cards"],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
